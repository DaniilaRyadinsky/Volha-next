APP_ENV=PROD

GATEWAY_PORT=8080
PRODUCT_GRPC_ADDR=volha-product-service:8008
PRODUCT_GRPC_PORT=8008
PRODUCT_GRPC_TIMEOUT=10s
AUTH_GRPC_ADDR=volha-auth-service:8009
CORS_ALLOWED_ORIGINS=http://localhost:3000

POSTGRES_HOST=volha-productsdb
POSTGRES_PORT=5432
POSTGRES_DB=volha
POSTGRES_USER=volha
POSTGRES_PASSWORD=change-me
POSTGRES_MAX_OPEN_CONNS=10
POSTGRES_MAX_IDLE_CONNS=5
POSTGRES_CONN_MAX_LIFETIME=30m
POSTGRES_CONN_MAX_IDLE_TIME=5m
POSTGRES_PING_TIMEOUT=5s

# Use a unique random value of at least 32 bytes outside local development.
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-bytes
# Set true when the gateway is served over HTTPS.
COOKIE_SECURE=false
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

REDIS_ADDR=volha-redis:6379
REDIS_PASSWORD=change-me
REDIS_DICTIONARIES_TTL=10m

DEV_ADMIN_TOKEN=change-me

LOG_LEVEL=info
LOG_FORMAT=json
VERSION=dev
COMMIT=unknown
BUILD_TIME=unknown

METRICS_ENABLED=true
PPROF_ENABLED=false
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLER_RATIO=0.1
SLOW_REQUEST_THRESHOLD=1s

GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=
